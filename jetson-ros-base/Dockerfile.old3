FROM ros:jazzy

ENV DEBIAN_FRONTEND=noninteractive

RUN rm -f /etc/apt/sources.list.d/ros2.list && \
	rm -f /usr/share/keyrings/ros-archive-keyring.gpg && \
	rm -rf /var/lib/apt/lists/* && \
	apt-get update && \
	apt-get install -y --no-install-recommends \
		ca-certificates \
		curl \
		git \
		gnupg \
		python3-pip \
		python3-rosdep && \
	apt-get update && \
	rm -rf /var/lib/apt/lists/*


WORKDIR /opt
RUN git clone \
		--branch isaac_sim_junk \
		--single-branch \
		--recurse-submodules \
		https://github.com/Gold-Rush-Robotics/IGVC_robot_2026.git && \
	git -C /opt/IGVC_robot_2026 submodule update --init --recursive

WORKDIR /opt/IGVC_robot_2026
RUN apt-get update && \
	if [ -d src ]; then \
		rosdep install --from-paths src --ignore-src -r -y --rosdistro jazzy; \
	else \
		rosdep install --from-paths . --ignore-src -r -y --rosdistro jazzy; \
	fi && \
	rm -rf /var/lib/apt/lists/* && \
    rm -rf /opt/IGVC_robot_2026/


# Python ML stack from Dockerfile.old

RUN apt update && apt install -y python3-full && \
    rm -rf /var/lib/apt/lists/* 
RUN python3 -m pip install --no-cache-dir --ignore-installed \
        opencv-python-headless --break-system-packages && \
    python3 -m pip install --no-cache-dir --ignore-installed sympy --break-system-packages && \
    python3 -m pip install --no-cache-dir \
        --index-url https://pypi.jetson-ai-lab.io/jp6/cu128 \
        torch torchvision --force-reinstall --break-system-packages && \
    python3 -m pip install --no-cache-dir \
        ultralytics \
        transforms3d --break-system-packages && \
    python3 -m pip install --no-cache-dir --force-reinstall \
        "numpy==1.26.4" --break-system-packages

# ---------------------------------------------------------------------------
# Runtime libs required by the Jetson PyTorch wheel:
#   - libopenblas0: dynamic BLAS
#   - libcudss0-cuda-12: NVIDIA cuDSS (not shipped with JetPack by default).
#     Installs under /usr/lib/aarch64-linux-gnu/libcudss/12/ so add an
#     ld.so.conf entry.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        libopenblas0 \
        libopenblas-dev \
        libcap-dev \
        libompl-dev \
        python3-pyqt5 \
    && curl -sSL -o /tmp/cuda-keyring.deb \
        https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/arm64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i /tmp/cuda-keyring.deb && \
    rm -f /tmp/cuda-keyring.deb && \
    apt-get update && apt-get install -y --no-install-recommends \
        libcudss0-cuda-12 \
    && rm -rf /var/lib/apt/lists/* && \
    echo "/usr/lib/aarch64-linux-gnu/libcudss/12" > /etc/ld.so.conf.d/cudss.conf && \
    ldconfig

